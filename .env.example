# Copy this file to .env and fill in real values. Never commit .env.
BASE_URL=https://store.ui.com/us/en
STORE_EMAIL=
STORE_PASSWORD=
# Path (relative to BASE_URL) of the fixed product used by the test.
PRODUCT_PATH=/products/usw-flex-mini
# Text expected to identify the product inside the cart (name/variant).
PRODUCT_NAME=Flex Mini
HEADLESS=true
